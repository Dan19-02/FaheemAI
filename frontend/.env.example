# Copy to .env.local and fill in. .env.local is gitignored; never commit secrets.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Backend base URL. Leave BLANK for local dev: the Vite dev server proxies
# /api to the backend (see vite.config.ts). Set it in production to your
# deployed backend origin, e.g. https://api.faheem.ai
VITE_API_URL=

# ---- Continue with Google (Google Identity Services) ----
# The OAuth 2.0 "Web application" Client ID from Google Cloud Console
# (APIs & Services > Credentials). It ends with .apps.googleusercontent.com and
# is safe to expose to the browser. It MUST match the backend's GOOGLE_CLIENT_ID.
# Leave blank to hide the Google button (email/password keeps working).
# Full walkthrough: ../backend/GOOGLE_AUTH_SETUP.md
VITE_GOOGLE_CLIENT_ID=

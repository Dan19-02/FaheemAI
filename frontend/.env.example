# Faheem frontend (Vite) — BUILD-TIME config. Copy to .env.local for dev overrides.
# NOTE: Vite bakes VITE_* vars into the bundle at build time, so changing any of
# these in production requires a rebuild/redeploy — not just a restart.

# Base URL of the backend API, WITH scheme and NO trailing slash.
#   dev:  leave empty — vite.config.ts proxies /api -> http://localhost:4000
#   prod: set to the deployed backend origin, e.g. https://faheem-backend-t2oh.onrender.com
# If this is wrong/empty in a static build, every /api call and auth request 404s
# against the static host.
VITE_API_URL=

# Google OAuth client id for the "Continue with Google" button (optional; use the
# SAME value as the backend's GOOGLE_CLIENT_ID). When empty, the Google button is
# compiled out entirely.
VITE_GOOGLE_CLIENT_ID=

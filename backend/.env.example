# Copy to .env and set your real key
# NEVER commit your real key to source control.
# ---- Backend configuration ----
PORT=4000

# Allowed browser origin for CORS (the frontend dev server). "*" to allow all.
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string. Examples:
#   Local:  postgresql://postgres:postgres@localhost:5432/faheem
#   Neon:   postgresql://USER:PASS@ep-xxx.aws.neon.tech/faheem?sslmode=require
# Free cloud Postgres in ~2 min: https://neon.tech  (or Supabase / Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/faheem

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# ---- Continue with Google (Google Identity Services) ----
# The OAuth 2.0 "Web application" Client ID from Google Cloud Console
# (APIs & Services > Credentials). The SAME id must be set on the frontend as
# VITE_GOOGLE_CLIENT_ID. The backend verifies Google's ID token against it.
# See GOOGLE_AUTH_SETUP.md for the full walkthrough. Leave blank to disable
# Google sign in (email/password keeps working).
GOOGLE_CLIENT_ID=
# The client SECRET is NOT required for this ID-token flow, but you can store it
# here for reference or a future server-side authorization-code flow.
GOOGLE_CLIENT_SECRET=

# Gemini: the ONLY generation key this branch needs. Everything runs on
# gemini-3.5-flash: normal answers on default thinking; reasoning, Deep
# understanding, chapter mastery, and notebook notes on extended (HIGH)
# thinking; Google Search grounding available on every call. Plus Deep-check,
# embeddings/RAG, and image understanding.
GEMINI_API_KEY=

# ---- Razorpay (payments) ----
# One-time monthly passes: Starter $4.99, Regular $9.99, Unlimited $19.99. Every
# new account gets a 7-day free trial (10 questions/day) before a pass is needed.
# Get TEST keys from the Razorpay dashboard: Settings > API Keys (they start with
# rzp_test_). The KEY_ID is public (sent to the browser); the KEY_SECRET must stay
# on the server only. Live keys start with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional server-to-server backstop. Create a webhook in the Razorpay dashboard
# pointing at <backend>/api/billing/webhook for the payment.captured event, then
# paste its secret here. Payments work without this; it just adds resilience.
RAZORPAY_WEBHOOK_SECRET=

# Optional operator tool: POST /api/billing/admin/grant comps a pass to an
# account without a payment (internal testers, support goodwill). Inert when
# unset. Generate with: openssl rand -hex 24. Keep it out of chats and git.
#   curl -X POST <backend>/api/billing/admin/grant \
#     -H "x-admin-token: <this token>" -H "Content-Type: application/json" \
#     -d '{"email":"tester@example.com","plan":"unlimited","days":365}'
ADMIN_GRANT_TOKEN=

# ---- Transactional email (password reset + email verification) ----
# The ONLY delivery channel for reset/verification codes. Without a key, dev
# prints codes to the server console; PRODUCTION with no key CANNOT send codes
# (account recovery breaks), so set this before relying on it.
# Resend: create an API key at https://resend.com (free tier ~3k/mo). SES works
# too by pointing MAIL_API_URL at a compatible endpoint (see mailer.ts).
RESEND_API_KEY=
# From address. Use a verified domain (add SPF + DKIM + DMARC records) and
# ideally a dedicated subdomain, e.g. Faheem AI <no-reply@mail.faheem.ai>.
MAIL_FROM=
# Student-facing support contact shown in error copy and emails.
SUPPORT_EMAIL=
# Optional: override the provider endpoint (defaults to Resend's).
MAIL_API_URL=

# ---- OTP tuning (all optional; sensible defaults shown) ----
# A dedicated secret (pepper) used to HMAC one-time codes before storing them,
# so a DB leak cannot reverse a 6-digit code. Falls back to JWT_SECRET if unset;
# set a distinct value in production. Generate with: openssl rand -hex 32
OTP_PEPPER=
OTP_TTL_MIN=10            # code lifetime in minutes
OTP_MAX_ATTEMPTS=5        # wrong guesses before a code is dead
OTP_RESEND_COOLDOWN_SEC=60 # min seconds between resends
OTP_MAX_PER_HOUR=5        # hard cap on codes per email per hour

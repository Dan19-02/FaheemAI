# Fahim backend configuration. Copy to .env and fill in. NEVER commit .env.

# --- Server ---
PORT=4000
# Comma-separated allowed origins, or "*" for dev.
CORS_ORIGIN=*

# --- Database (Postgres) ---
# Leave unset in dev to use the zero-setup in-memory fallback (data resets on restart).
# DATABASE_URL=postgresql://user:pass@host:5432/fahim
DB_CONNECT_ATTEMPTS=6
DB_CONNECT_TIMEOUT_MS=15000
# Set false for a local Postgres without TLS.
PGSSL=false

# --- Auth ---
# Long random string. Rotate if ever exposed.
JWT_SECRET=
# Google OAuth client id (also set as VITE_GOOGLE_CLIENT_ID in the frontend).
GOOGLE_CLIENT_ID=

# --- AI provider adapter ---
# Which provider backs generate()/embed(). Default 'gemini' for the prototype;
# the Arabic bake-off (PRD S10) decides the production winner, then flip this.
FAHIM_PROVIDER=gemini
GEMINI_API_KEY=
FAHIM_GENERATION_MODEL=gemini-3.5-flash
FAHIM_EMBED_MODEL=gemini-embedding-001

# --- Resilience (timeouts + circuit breaker) ---
# Hard ceilings so a stalled provider call can never blow the p95<15s budget.
MODEL_TIMEOUT_MS=20000
EMBED_TIMEOUT_MS=8000
MODEL_MAX_RETRIES=2
# Circuit breaker: open after N consecutive failures, stay open for cooldown ms.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000

# --- Accuracy engine tuning ---
# Below this in-unit cosine, a query is treated as out-of-syllabus and FLAGGED.
RETRIEVAL_GATE=0.62
SEMANTIC_THRESHOLD=0.9

# --- Billing (DORMANT in v2: no monetization). Left here for reference only. ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
